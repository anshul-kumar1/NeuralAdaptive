{
    "manifest_version": 3,
    "name": "NeuralAdaptive",
    "version": "2.0.13",
    "description": "Eye-tracking responsive reading interface for students with dyslexia and ADHD.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "sidePanel"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "webgazer.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "webgazer.js",
                "mediapipe/face_mesh/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "NeuralAdaptive",
        "default_icon": "icons/icon48.png"
    }
}
