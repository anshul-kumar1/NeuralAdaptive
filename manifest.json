{
    "manifest_version": 3,
    "name": "NeuralAdaptive",
    "version": "3.0.0",
    "description": "Eye-tracking responsive reading interface for students with dyslexia and ADHD.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "mediapipe/face_mesh/*",
                "iris-tracker.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "NeuralAdaptive",
        "default_icon": "icons/icon48.png"
    }
}
