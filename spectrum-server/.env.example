# ──────────────────────────────────────────────────────────────
# NeuralAdaptive — Photon Spectrum Companion Server Config
# ──────────────────────────────────────────────────────────────
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Fill in your own credentials from https://photon.codes
# 3. Run:  npm install && npm start
#
# NEVER commit your real .env — the repo-root .gitignore already
# excludes it. Values below are placeholders.

# iMessage delivery mode (in order of least friction to most):
#   applescript — default. Drives Messages.app via osascript. First send
#                 triggers a one-time "allow Terminal to control Messages"
#                 prompt. No Full Disk Access needed.
#   local       — @photon-ai/imessage-kit. Requires Full Disk Access granted
#                 to the terminal app (System Settings > Privacy & Security).
#   cloud       — routes through Spectrum Cloud (Photon). Requires the
#                 project credentials below AND the recipient to be on your
#                 project's user allowlist.
IMESSAGE_MODE=applescript

# Photon project credentials — only needed when IMESSAGE_MODE=cloud
PHOTON_PROJECT_ID=your-photon-project-id
PHOTON_PROJECT_SECRET=your-photon-project-secret

# Your iMessage-capable phone number or Apple ID email.
# The session summary will be sent here.
RECIPIENT_PHONE=+15551234567

# Optional: change the port the companion server listens on
# PORT=3847

# ──────────────────────────────────────────────────────────────
# Reading-Coach Agent (Dedalus / Claude)
# ──────────────────────────────────────────────────────────────
# The server runs a tool-calling agent against Dedalus to generate a
# personalized coaching blurb that gets appended to the iMessage.
# If this key is missing the server falls back to the stats-only template.
DEDALUS_API_KEY=dsk-your-dedalus-key

# Optional: override the model Dedalus routes to
# DEDALUS_MODEL=anthropic/claude-haiku-4-5-20251001
