# ──────────────────────────────────────────────────────────────
# NeuralAdaptive — Photon Spectrum Companion Server Config
# ──────────────────────────────────────────────────────────────
# 1. Copy this file to .env
# 2. Fill in your credentials from https://photon.codes
# 3. Run:  npm install && npm start

# iMessage delivery mode:
#   "applescript" — drives Messages.app via osascript. No Full Disk Access
#                   needed; one-time Automation prompt on first send.
#   "local"       — imessage-kit SDK. Requires Full Disk Access granted to
#                   the terminal app running Node.
#   "cloud"       — Spectrum Cloud (Photon). Subject to project allowlists.
IMESSAGE_MODE=applescript

# Photon project credentials — only consulted when IMESSAGE_MODE=cloud
PHOTON_PROJECT_ID=645d6c6e-f6f3-4d5f-a2b7-b5a83bbeb376
PHOTON_PROJECT_SECRET=8F8aerG8Aqk0ll-0QnTTlwOlOjEWDiqRrfAZNuVN9ng

# Your iMessage-capable phone number or Apple ID email
# The session summary will be sent to this address
RECIPIENT_PHONE=+18127786611

# Optional: change the port the companion server listens on
# PORT=3847

# ──────────────────────────────────────────────────────────────
# Reading-Coach Agent (Dedalus / Claude)
# ──────────────────────────────────────────────────────────────
# The server runs a tool-calling agent against Dedalus to generate a
# personalized coaching blurb that gets appended to the iMessage.
# If this key is missing the server falls back to the stats-only template.
DEDALUS_API_KEY=dsk-test-94af530a2791-b3bc6d4ca5fdcc568dce33e70df376a2

# Optional: override the model Dedalus routes to
# DEDALUS_MODEL=anthropic/claude-haiku-4-5-20251001
